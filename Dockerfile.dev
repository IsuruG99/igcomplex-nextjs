FROM node:24-alpine

WORKDIR /app

RUN addgroup --system --gid 1000 nodejs && \
	adduser --system --uid 1000 nextjs

# Copy package files first for better caching
COPY package*.json ./
RUN npm ci

RUN chown -R nextjs:nodejs /app

# Don't copy source - it comes via volume mount
EXPOSE 3000

# Critical for hot reload on macOS/Windows
ENV WATCHPACK_POLLING=true

USER nextjs

CMD ["npm", "run", "dev"]
