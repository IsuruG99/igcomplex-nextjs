# IGComplex — Environment Contract
# Supabase for DB + public Storage. Custom minimal owner auth (no "add user" UI ever).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CV_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=#https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=#"sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY=#"sb_secret_..."
SUPABASE_STORAGE_BUCKET_MEDIA=media

# Owner auth (single person, compared against supabase & the env bcrypt hash)
# Fixed username + bcrypt password hash.
# Local .env files must escape each $ in the bcrypt hash as \$.
# Vercel env variables should use the raw hash value without backslashes.
OWNER_USERNAME=#abc
OWNER_PASSWORD_HASH=#"\$2a\$01\$..."
OWNER_SESSION_SECRET=#ANY_STRING_IS_FINE(IDK_WHY_I_EVEN_MADE_THIS_A_ENV_VAR_BUT_YOU_GET_THE_IDEA)

# Generate a new hash (after npm install):
#   node -e "const b=require('bcryptjs'); console.log(b.hashSync('your-new-password', 10))"
# For local .env, paste it as:
#   OWNER_PASSWORD_HASH="\$2a\$10\$..."
# For Vercel, paste the raw $2a$10$... value in the dashboard.
